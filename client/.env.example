# ConnectED client (Vite). Copy this file to `.env` and adjust.
#
# NOTE: Vite inlines these at BUILD time. Rebuild the client after changing them.

# Base URL of the ConnectED API. Must include the `/api` suffix.
VITE_API_BASE_URL="http://localhost:8000/api"

# Optional: phone number displayed on the driver dashboard dispatch panel.
# VITE_DRIVER_DISPATCH_PHONE="+95 9 xxx xxx xxx"
