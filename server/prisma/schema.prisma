generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model Admin {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName     String
  phoneNumber  String   @default("")
  username     String   @unique
  email        String?
  password     String
  isActive     Boolean  @default(true)
  isBanned     Boolean  @default(false)
  role         String   @default("admin")
  address      String   @default("")
  profilePhoto String   @default("")
  gender       String   @default("male")
  birthday     DateTime
  bio          String   @default("")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Teacher {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName     String
  phoneNumber  String   @default("")
  username     String   @unique
  email        String?
  password     String
  isActive     Boolean  @default(true)
  isBanned     Boolean  @default(false)
  role         String   @default("teacher")
  address      String   @default("")
  profilePhoto String   @default("")
  gender       String   @default("male")
  birthday     DateTime
  bio          String   @default("")
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  primaryClassId String? @db.ObjectId
  primaryClass   Class?  @relation("PrimaryClass", fields: [primaryClassId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Back-relation of `Class.teacher`: the classes this person leads.
  classes Class[]  @relation("ClassTeacher")
  lessons Lesson[]

  /// MongoDB has no implicit many-to-many, so both links below are kept as
  /// plain lists of ids and expanded to full documents in the service layer.
  subjectIds String[] @default([])

  /// Classes the teacher is timetable-ed into (independent from `classes`).
  assignedClassIds String[] @default([])
}

model Student {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName     String
  phoneNumber  String   @default("")
  username     String   @unique
  email        String?
  password     String
  isActive     Boolean  @default(true)
  isBanned     Boolean  @default(false)
  role         String   @default("student")
  address      String   @default("")
  profilePhoto String   @default("")
  gender       String   @default("male")
  birthday     DateTime
  bio          String   @default("")
  status       String   @default("enrolled")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentId String? @db.ObjectId
  parent   Parent? @relation(fields: [parentId], references: [id])

  classId String? @db.ObjectId
  class   Class?  @relation("StudentClass", fields: [classId], references: [id])

  attendances Attendance[]
  results     Result[]

  /// Buses this student rides (pickup/dropoff stops live on the assignment).
  busAssignments BusStudentAssignment[]
  boardingEvents BoardingEvent[]
}

model Parent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName     String
  phoneNumber  String   @default("")
  username     String   @unique
  email        String?
  password     String
  isActive     Boolean  @default(true)
  isBanned     Boolean  @default(false)
  role         String   @default("parent")
  address      String   @default("")
  profilePhoto String   @default("")
  gender       String   @default("male")
  birthday     DateTime
  bio          String   @default("")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  children Student[]
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model Room {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  capacity  Int      @default(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]
  lessons Lesson[]
}

model Class {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  capacity Int    @default(30)
  grade    String @default("")
  status   String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String?  @db.ObjectId
  teacher   Teacher? @relation("ClassTeacher", fields: [teacherId], references: [id])

  roomId String? @db.ObjectId
  room   Room?   @relation(fields: [roomId], references: [id])

  primaryTeachers Teacher[]      @relation("PrimaryClass")
  students        Student[]      @relation("StudentClass")
  lessons         Lesson[]
  announcements   Announcement[]
  events          Event[]
  attendances     Attendance[]
  results         Result[]
}

model Subject {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  imgUrl      String   @default("")
  description String   @default("")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]
}

model Lesson {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  day       String   @default("MONDAY")
  startTime DateTime
  endTime   DateTime
  status    String   @default("scheduled")
  videos    String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjectId String?  @db.ObjectId
  subject   Subject? @relation(fields: [subjectId], references: [id])

  classId String? @db.ObjectId
  class   Class?  @relation(fields: [classId], references: [id])

  teacherId String?  @db.ObjectId
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  roomId String? @db.ObjectId
  room   Room?   @relation(fields: [roomId], references: [id])

  exams       Exam[]
  assignments Assignment[]
  attendances Attendance[]
}

model Exam {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  startTime DateTime
  endTime   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonId String? @db.ObjectId
  lesson   Lesson? @relation(fields: [lessonId], references: [id])

  results Result[]
}

model Assignment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  startDate DateTime
  dueDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonId String? @db.ObjectId
  lesson   Lesson? @relation(fields: [lessonId], references: [id])

  results Result[]
}

// ---------------------------------------------------------------------------
// Records
// ---------------------------------------------------------------------------

model Result {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  score       Int    @default(0)
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId String?  @db.ObjectId
  student   Student? @relation(fields: [studentId], references: [id])

  examId String? @db.ObjectId
  exam   Exam?   @relation(fields: [examId], references: [id])

  assignmentId String?     @db.ObjectId
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])

  classId String? @db.ObjectId
  class   Class?  @relation(fields: [classId], references: [id])
}

model Attendance {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime @default(now())
  present     Boolean  @default(true)
  late        Boolean  @default(false)
  minutesLate Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId String?  @db.ObjectId
  student   Student? @relation(fields: [studentId], references: [id])

  lessonId String? @db.ObjectId
  lesson   Lesson? @relation(fields: [lessonId], references: [id])

  classId String? @db.ObjectId
  class   Class?  @relation(fields: [classId], references: [id])
}

// `createdBy` is polymorphic (admin | teacher), so it is stored as a plain
// id + model pair and resolved on read by the service layer.
model Announcement {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String   @default("")
  date           DateTime
  status         String   @default("pending")
  createdByModel String   @default("admin")
  createdById    String?  @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classId String? @db.ObjectId
  class   Class?  @relation(fields: [classId], references: [id])
}

model Event {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String   @default("")
  startDate      DateTime
  endDate        DateTime
  status         String   @default("pending")
  createdByModel String   @default("admin")
  createdById    String?  @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classId String? @db.ObjectId
  class   Class?  @relation(fields: [classId], references: [id])
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

// One conversation per user pair. `participantIds` holds exactly two ids that
// may point at any of the four user models, so participants are resolved on
// read instead of through a Prisma relation.
model Conversation {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  participantIds String[]
  requestedById  String
  status         String   @default("pending")
  /// Set when one participant blocks the other: holds the blocker's id.
  blockedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages Message[]

  @@index([participantIds])
}

model Message {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String    @db.ObjectId
  senderId       String
  text           String    @default("")
  /// [{ url, name, type, size }] — files uploaded via /api/upload/file.
  attachments    Json?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Transportation
// ---------------------------------------------------------------------------

// Driver profile (uses existing auth user model pattern; linked via User role=DRIVER conceptually)
model Driver {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName     String
  phoneNumber  String   @default("")
  username     String   @unique
  email        String?
  password     String
  isActive     Boolean  @default(true)
  isBanned     Boolean  @default(false)
  role         String   @default("driver")
  address      String   @default("")
  profilePhoto String   @default("")
  gender       String   @default("male")
  birthday     DateTime
  bio          String   @default("")
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // @unique is required by Prisma for this one-to-one relation. MongoDB
  // unique indexes reject a second missing value, so a driver is always
  // created together with their bus (see prisma/seed.ts).
  busId String? @unique @db.ObjectId
  bus   Bus?    @relation("DriverBus", fields: [busId], references: [id], onDelete: SetNull)

  trips          Trip[]
  boardingEvents BoardingEvent[]
  incidents      Incident[]
  fuelRecords    FuelRecord[]
  driverShifts   DriverShift[]
}

model Route {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  description       String   @default("")
  startLocation     String   @default("")
  endLocation       String   @default("")
  estimatedDuration Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stops     RouteStop[]
  buses     Bus[]
  trips     Trip[]
  incidents Incident[]
}

model RouteStop {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  routeId          String   @db.ObjectId
  name             String
  latitude         Float
  longitude        Float
  sequence         Int      @default(0)
  estimatedArrival Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  pickupAssignments  BusStudentAssignment[] @relation("PickupStop")
  dropoffAssignments BusStudentAssignment[] @relation("DropoffStop")
  boardingEvents     BoardingEvent[]
}

model Bus {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  busNumber          String
  registrationNumber String    @unique
  name               String    @default("")
  capacity           Int       @default(30)
  driverId           String?   @db.ObjectId
  routeId            String?   @db.ObjectId
  status             String    @default("OFFLINE")
  isActive           Boolean   @default(true)
  currentLatitude    Float     @default(0)
  currentLongitude   Float     @default(0)
  currentSpeed       Float     @default(0)
  heading            Float     @default(0)
  lastLocationAt     DateTime?
  // -- Fleet record details (optional) ------------------------------------
  make                 String    @default("")
  model                String    @default("")
  year                 Int?
  color                String    @default("")
  vehicleType          String    @default("")
  fuelType             String    @default("")
  fuelConsumption      Float?
  mileage              Int       @default(0)
  purchaseDate         DateTime?
  purchasePrice        Float?
  warrantyExpiresAt    DateTime?
  insuranceProvider    String    @default("")
  insurancePolicyNumber String   @default("")
  insuranceExpiresAt   DateTime?
  lastInspectionAt     DateTime?
  nextInspectionDueAt  DateTime?
  registrationExpiresAt DateTime?
  notes                String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  driver Driver? @relation("DriverBus")
  route  Route?  @relation(fields: [routeId], references: [id], onDelete: SetNull)

  studentAssignments BusStudentAssignment[]
  locationHistory    BusLocation[]
  trips              Trip[]
  boardingEvents     BoardingEvent[]
  incidents          Incident[]
  fuelRecords        FuelRecord[]
  driverShifts       DriverShift[]
  maintenanceRecords MaintenanceRecord[]
}

model BusStudentAssignment {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId     String    @db.ObjectId
  busId         String    @db.ObjectId
  routeId       String?   @db.ObjectId
  pickupStopId  String?   @db.ObjectId
  dropoffStopId String?   @db.ObjectId
  isActive      Boolean   @default(true)
  assignedAt    DateTime  @default(now())
  endedAt       DateTime?

  bus         Bus        @relation(fields: [busId], references: [id], onDelete: Cascade)
  student     Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  pickupStop  RouteStop? @relation("PickupStop", fields: [pickupStopId], references: [id], onDelete: SetNull)
  dropoffStop RouteStop? @relation("DropoffStop", fields: [dropoffStopId], references: [id], onDelete: SetNull)
}

model BusLocation {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  busId      String   @db.ObjectId
  latitude   Float
  longitude  Float
  speed      Float    @default(0)
  heading    Float    @default(0)
  accuracy   Float    @default(0)
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  bus Bus @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@index([busId, recordedAt])
}

// ---------------------------------------------------------------------------
// Transportation - Trips, Boarding, Geofencing, Incidents, Maintenance, Fuel
// ---------------------------------------------------------------------------

enum TripType {
  MORNING
  AFTERNOON
  SPECIAL
  CUSTOM
}

enum TripStatus {
  SCHEDULED
  READY
  BOARDING
  IN_PROGRESS
  DELAYED
  ARRIVED
  COMPLETED
  CANCELLED
  EMERGENCY
}

model Trip {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  busId            String     @db.ObjectId
  driverId         String     @db.ObjectId
  routeId          String     @db.ObjectId
  tripType         TripType   @default(MORNING)
  status           TripStatus @default(SCHEDULED)
  scheduledStartAt DateTime?
  actualStartAt    DateTime?
  scheduledEndAt   DateTime?
  actualEndAt      DateTime?
  delayMinutes     Int        @default(0)
  startedBy        String?    @db.ObjectId
  completedBy      String?    @db.ObjectId
  notes            String     @default("")
  odometerStart    Int?
  odometerEnd      Int?
  distanceKm       Float?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  bus    Bus    @relation(fields: [busId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])
  route  Route  @relation(fields: [routeId], references: [id])

  boardingEvents BoardingEvent[]
  incidents      Incident[]

  @@index([busId, status, scheduledStartAt])
  @@index([driverId, status, scheduledStartAt])
  @@index([routeId, scheduledStartAt])
}

enum BoardingEventType {
  BOARDED
  ABSENT
  DROPPED_OFF
  LEFT_BUS
  MANUAL_OVERRIDE
}

enum BoardingMethod {
  QR
  MANUAL
  NFC
  SYSTEM
}

model BoardingEvent {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  tripId     String            @db.ObjectId
  busId      String            @db.ObjectId
  studentId  String            @db.ObjectId
  driverId   String            @db.ObjectId
  stopId     String?           @db.ObjectId
  eventType  BoardingEventType @default(BOARDED)
  method     BoardingMethod    @default(MANUAL)
  occurredAt DateTime          @default(now())
  latitude   Float?
  longitude  Float?
  notes      String            @default("")
  createdAt  DateTime          @default(now())

  trip    Trip       @relation(fields: [tripId], references: [id])
  bus     Bus        @relation(fields: [busId], references: [id])
  student Student    @relation(fields: [studentId], references: [id])
  driver  Driver     @relation(fields: [driverId], references: [id])
  stop    RouteStop? @relation(fields: [stopId], references: [id])

  @@index([tripId, studentId, eventType])
  @@index([busId, occurredAt])
}

enum GeofenceType {
  SCHOOL
  PICKUP_STOP
  DROPOFF_STOP
  DEPOT
  CUSTOM
}

model Geofence {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      GeofenceType @default(CUSTOM)
  latitude  Float
  longitude Float
  radius    Float        @default(50)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum IncidentType {
  ACCIDENT
  MEDICAL
  BREAKDOWN
  ROUTE_DEVIATION
  SECURITY
  GPS_FAILURE
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
}

model Incident {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  busId       String           @db.ObjectId
  driverId    String           @db.ObjectId
  tripId      String?          @db.ObjectId
  routeId     String?          @db.ObjectId
  type        IncidentType     @default(OTHER)
  severity    IncidentSeverity @default(MEDIUM)
  description String           @default("")
  latitude    Float?
  longitude   Float?
  occurredAt  DateTime         @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  status      IncidentStatus   @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  bus    Bus    @relation(fields: [busId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])
  trip   Trip?  @relation(fields: [tripId], references: [id])
  route  Route? @relation(fields: [routeId], references: [id])

  @@index([busId, occurredAt])
  @@index([driverId, occurredAt])
  @@index([status])
}

enum MaintenanceStatus {
  REPORTED
  APPROVED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model MaintenanceRecord {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  busId             String               @db.ObjectId
  ticketNumber      String               @default("")
  title             String               @default("")
  type              String
  status            MaintenanceStatus    @default(REPORTED)
  priority          MaintenancePriority  @default(MEDIUM)
  severity          MaintenanceSeverity  @default(MEDIUM)
  blocksOperation   Boolean              @default(true)
  mileage           Int?
  date              DateTime
  description       String               @default("")
  reportedBy        String?              @db.ObjectId
  reportedByName    String               @default("")
  reviewedBy        String?              @db.ObjectId
  reviewedByName    String               @default("")
  serviceProvider   String               @default("")
  technician        String               @default("")
  plannedDate       DateTime?
  scheduledDate     DateTime?
  actualStartAt     DateTime?
  actualCompletedAt DateTime?
  workPerformed     String               @default("")
  partsReplaced     String               @default("")
  partsCost         Float?
  laborCost         Float?
  otherCost         Float?
  totalCost         Float?
  inspectionResult  String               @default("")
  cost              Float?
  performedBy       String?
  nextDueAt         DateTime?
  nextDueMileage    Int?
  completedBy       String?              @db.ObjectId
  completedByName   String               @default("")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  bus Bus @relation(fields: [busId], references: [id])

  @@index([busId, date])
  @@index([busId, status])
  @@index([status])
}

model FuelRecord {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  busId         String   @db.ObjectId
  driverId      String   @db.ObjectId
  date          DateTime
  liters        Float
  pricePerLiter Float?
  totalCost     Float?
  odometer      Int?
  station       String   @default("")
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bus    Bus    @relation(fields: [busId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([busId, date])
}

model DriverShift {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  driverId   String    @db.ObjectId
  shiftStart DateTime
  shiftEnd   DateTime?
  notes      String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  driver Driver  @relation(fields: [driverId], references: [id])
  bus    Bus?    @relation(fields: [busId], references: [id])
  busId  String? @db.ObjectId

  @@index([driverId, shiftStart])
}
