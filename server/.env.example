# ConnectED API server
PORT=8000

# MongoDB connection (docker -> see docker-compose.yml)
DATABASE_URL="mongodb://127.0.0.1:27017/connected"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# CORS — comma separated list of allowed origins.
# Leave empty to allow every origin (handy for local development).
CLIENT_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Public base url used for generated links (uploaded images, ...)
PUBLIC_URL="http://localhost:8000"

# Transportation / live fleet map
# Freshness thresholds (seconds) for a bus location: LIVE < fresh, then
# DELAYED, then STALE, then OFFLINE past staleSeconds.
FRESH_LOCATION_SECONDS=15
DELAYED_LOCATION_SECONDS=60
STALE_LOCATION_SECONDS=300

# OpenStreetMap-compatible raster tiles. No API key required for OSM.
# If your provider needs a key, put it in the URL here — never in source.
MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"

# Fallback map centre when no bus has reported a position yet.
# Taungoo, Bago Region (East), Myanmar.
MAP_CENTER_LATITUDE=18.9398
MAP_CENTER_LONGITUDE=96.4310
MAP_DEFAULT_ZOOM=14

# Demo-only GPS simulator. With no real devices reporting positions, this
# fabricates bus movement so the live map is populated out of the box. The
# code default is `true`; set it to `false` in production.
# FLEET_SIMULATION_ENABLED=false
# FLEET_SIMULATION_TICK_SECONDS=4
